[Unit]
Description=MM-Companion relay (TLS byte-pump for session traffic)
Documentation=https://github.com/Mrzillka/MM_Companion/blob/main/docs/mm-session-networking.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mm
Group=mm
WorkingDirectory=/home/mm/MM_Companion

# --session-ttl is in HOURS. The stock 12 h is meant for a GM's laptop hosting an
# evening's game; a session parked here by the hub is meant to outlive that, so it
# is raised to 30 days. The hub re-registers on its own if a link is ever dropped,
# so this is a safety valve against a leaked session, not the normal path.
#
# --idle-timeout is in SECONDS, and the stock 120 s assumes every peer keeps its
# link warm. That is true of the GM's control link, which pings every 30 s, and
# false of every data stream: a table that is roleplaying rolls nothing and edits
# no sheet, so its connections send nothing at all and are reaped after two
# minutes, taking the paired half with them. Raised to 4 h until the client
# keepalive ships (SessionClient.ping exists and is wired to nothing today); put
# it back to the default once every client pings for itself.
ExecStart=/home/mm/MM_Companion/.venv/bin/python -m mm_companion.relay \
    --port 47332 \
    --session-ttl 720 \
    --idle-timeout 14400 \
    --cert /etc/letsencrypt/live/mmcompanion.duckdns.org/fullchain.pem \
    --key /etc/letsencrypt/live/mmcompanion.duckdns.org/privkey.pem

Restart=on-failure
RestartSec=5s

# The relay holds no state and reads nothing but its cert, so it can be locked
# down hard. ProtectHome=read-only rather than true: the venv and the code live
# under /home/mm.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
